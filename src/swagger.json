          {
            "in": "path",
            "name": "bookingId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the booking to update"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "price": {
                    "type": "number",
                    "format": "float",
                    "description": "The price to set for the booking"
                  }
                },
                "required": ["price"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking updated successfully"
          },
          "400": {
            "description": "Invalid price or booking status"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
